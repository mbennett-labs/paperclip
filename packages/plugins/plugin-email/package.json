{
  "name": "@qsl/plugin-email",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "QSL Email Company connector: governed email intake (IMAP poll -> issues) and Board-invoked reply send (SMTP) for Paperclip.",
  "scripts": {
    "prebuild": "pnpm --filter @paperclipai/plugin-sdk ensure-build-deps",
    "build": "node ./esbuild.config.mjs",
    "dev": "node ./esbuild.config.mjs --watch",
    "typecheck": "pnpm --filter @paperclipai/plugin-sdk ensure-build-deps && tsc --noEmit"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "keywords": [
    "paperclip",
    "plugin",
    "email",
    "qsl"
  ],
  "author": "QuantumShield Labs",
  "license": "UNLICENSED",
  "dependencies": {
    "imapflow": "^1.0.164",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "@paperclipai/plugin-sdk": "workspace:*",
    "@types/node": "^22.19.21",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
